# AI provider: "openai" or "groq" (both use the OpenAI-compatible API)
AI_PROVIDER=openai
OPENAI_API_KEY=
GROQ_API_KEY=
# Optional model override. Defaults: openai -> gpt-5-mini, groq -> openai/gpt-oss-120b
AI_MODEL=

# PayPal sandbox REST app credentials (developer.paypal.com -> Apps & Credentials -> Sandbox)
# Leave blank to run in simulated-payment mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: sandbox personal-account email that receives merchant payouts
# (Testing Tools -> Sandbox Accounts). Defaults to per-merchant demo emails.
PAYPAL_MERCHANT_RECEIVER=

PORT=3000
